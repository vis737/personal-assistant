@echo off
REM ===========================================================================
REM  JARVIS - register the logon launcher with Task Scheduler
REM
REM  Run this ONCE as Administrator. The ONLOGON trigger needs admin rights
REM  once; Jarvis itself runs as your normal user from then on.
REM
REM  Why a trampoline: the install path contains a space, and Task Scheduler
REM  mangles nested quotes in /TR when cmd hands them over. The trampoline at
REM  %LOCALAPPDATA%\Jarvis\run.vbs has no space in its path, so the task action
REM  is quote-free, and it just forwards to start_jarvis.vbs beside this script.
REM
REM  Undo later with:
REM      schtasks /Delete /TN "Jarvis Assistant" /F
REM ===========================================================================
setlocal enabledelayedexpansion

set "LAUNCHER=%~dp0start_jarvis.vbs"
set "TASK=Jarvis Assistant"
set "TRAMP_DIR=%LOCALAPPDATA%\Jarvis"
set "TRAMP=%TRAMP_DIR%\run.vbs"

if not exist "%LAUNCHER%" (
    echo [X] Missing launcher: %LAUNCHER%
    exit /b 1
)

echo [*] Writing trampoline: %TRAMP%
if not exist "%TRAMP_DIR%" mkdir "%TRAMP_DIR%" 2>nul

REM Every parenthesis and ampersand below is caret-escaped: cmd parses them
REM as grouping/redirection otherwise, which is what broke the first attempt.
echo ' Generated by Jarvis register_autostart.bat - do not edit by hand.>"%TRAMP%"
echo ' Forwards to start_jarvis.vbs, which sits beside register_autostart.bat.>>"%TRAMP%"
echo Dim homePath>>"%TRAMP%"
echo homePath = "%LAUNCHER%">>"%TRAMP%"
echo CreateObject^("WScript.Shell"^).Run "wscript.exe " ^& Chr^(34^) ^& homePath ^& Chr^(34^), 1, False>>"%TRAMP%"

if not exist "%TRAMP%" (
    echo [X] Could not write %TRAMP%
    exit /b 1
)

echo [*] Registering "%TASK%" to run at every logon...
schtasks /Delete /TN "%TASK%" /F >nul 2>&1

schtasks /Create /TN "%TASK%" /TR "wscript.exe %TRAMP%" /SC ONLOGON /F
if errorlevel 1 (
    echo [X] Could not create the task. Run this script as Administrator.
    exit /b 1
)

echo.
echo [OK] Registered - Jarvis now starts silently at every logon.
echo.
schtasks /Query /TN "%TASK%" /V /FO LIST | findstr /I /C:"TaskName" /C:"Task To Run" /C:"Schedule Type" /C:"Logon Mode"
echo.
echo [i] Start it right now with:  wscript "%LAUNCHER%"
echo [i] Remove autostart with:    schtasks /Delete /TN "%TASK%" /F
endlocal
exit /b 0
